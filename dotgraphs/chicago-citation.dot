        description_paper_conference_bib [label="description-paper-conference-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_paper_conference_note [label="description-paper-conference-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_bib [label="description-review-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_genre_bib [label="description-review-genre-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_genre_note [label="description-review-genre-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_note [label="description-review-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_short [label="description-review-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_term_unsigned_bib [label="description-review-term-unsigned-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_term_unsigned_note [label="description-review-term-unsigned-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_title [label="description-review-title", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_title_short [label="description-review-title-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_serial_bib [label="description-serial-bib", shape=box, style=filled, fillcolor="#FFFFFF"];
        description_serial_note [label="description-serial-note", shape=box, style=filled, fillcolor="#FFFFFF"];
        description_serial_short [label="description-serial-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_short [label="description-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_song_bib [label="description-song-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_song_note [label="description-song-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

