        title_and_part_title_note [label="title-and-part-title-note", shape=box, style=filled, fillcolor="#FFFFFF"];
        title_and_source_note [label="title-and-source-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_bib [label="title-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_note [label="title-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_part [label="title-part", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_primary [label="title-primary", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_primary_short [label="title-primary-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_short [label="title-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_volume [label="title-volume", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c3_desc {
        label="§3.2 Descripción"; style=filled; fillcolor="#FEF3E2";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        description_bib [label="description-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_format_bib [label="description-format-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_format_note [label="description-format-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_format_short [label="description-format-short", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
