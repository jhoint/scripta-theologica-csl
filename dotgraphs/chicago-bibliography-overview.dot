digraph CSL_Overview {
    label="CSL Bibliography — vista general";
    labelloc=t;
    rankdir=LR;
    splines=ortho;
    fontname="Helvetica"; fontsize=13;
    node [fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];

    __bibliography__ [label="<bibliography>", shape=ellipse, style=filled, fillcolor="#A9DFBF"];

    OV_c1_author [label="§1 Autor\n(4 macros)", shape=box, style=filled, fillcolor="#D6EAF8", width=2.0];
    OV_c2_date [label="§2 Fecha\n(8 macros)", shape=box, style=filled, fillcolor="#D1F8F5", width=2.0];
    OV_c3_title [label="§3.1 Título\n(8 macros)", shape=box, style=filled, fillcolor="#FEF9E7", width=2.0];
    OV_c3_desc [label="§3.2 Descripción\n(12 macros)", shape=box, style=filled, fillcolor="#FEF3E2", width=2.0];
    OV_c3_ident [label="§3.3 Identificadores\n(14 macros)", shape=box, style=filled, fillcolor="#FDEBD0", width=2.0];
    OV_c_label [label="Etiquetas\n(19 macros)", shape=box, style=filled, fillcolor="#F2F3F4", width=2.0];
    OV_c4_serial [label="§4.1 Serial\n(8 macros)", shape=box, style=filled, fillcolor="#EBF5EB", width=2.0];
    OV_c4_mono [label="§4.2 Monográfico\n(9 macros)", shape=box, style=filled, fillcolor="#D5F5E3", width=2.0];
    OV_c4_series_ev [label="§4.3-4 Serie/Evento\n(8 macros)", shape=box, style=filled, fillcolor="#ABEBC6", width=2.0];
    OV_c4_arch_url [label="§4.9-10 Arch./URL\n(7 macros)", shape=box, style=filled, fillcolor="#B2DFDB", width=2.0];
    OV_c4_pub_date [label="§4.5-6 Editor/Fecha\n(13 macros)", shape=box, style=filled, fillcolor="#C8E6C9", width=2.0];
    OV_c4_loc_med [label="§4.7-8 Loc./Medio\n(1 macros)", shape=box, style=filled, fillcolor="#A9DFBF", width=2.0];
    OV_c4_source [label="§4 Fuente (gen.)\n(1 macros)", shape=box, style=filled, fillcolor="#F0FFF4", width=2.0];
    OV_c5_notes [label="§5 Notas/Citas\n(1 macros)", shape=box, style=filled, fillcolor="#F5EEF8", width=2.0];

    __bibliography__ -> OV_c1_author [xlabel="1"];
    __bibliography__ -> OV_c3_title [xlabel="1"];
    __bibliography__ -> OV_c4_arch_url [xlabel="1"];
    __bibliography__ -> OV_c4_pub_date [xlabel="1"];
    __bibliography__ -> OV_c4_source [xlabel="1"];
    __bibliography__ -> OV_c5_notes [xlabel="1"];
    OV_c1_author -> OV_c3_title [xlabel="2"];
    OV_c1_author -> OV_c4_arch_url [xlabel="1"];
    OV_c1_author -> OV_c4_serial [xlabel="1"];
    OV_c3_desc -> OV_c2_date [xlabel="1"];
    OV_c3_desc -> OV_c4_series_ev [xlabel="3"];
    OV_c3_desc -> OV_c_label [xlabel="2"];
    OV_c3_ident -> OV_c2_date [xlabel="1"];
    OV_c3_ident -> OV_c3_title [xlabel="4"];
    OV_c3_ident -> OV_c_label [xlabel="11"];
    OV_c3_title -> OV_c3_desc [xlabel="2"];
    OV_c3_title -> OV_c3_ident [xlabel="3"];
    OV_c3_title -> OV_c4_arch_url [xlabel="2"];
    OV_c3_title -> OV_c4_loc_med [xlabel="1"];
    OV_c3_title -> OV_c4_mono [xlabel="3"];
    OV_c3_title -> OV_c4_series_ev [xlabel="2"];
    OV_c3_title -> OV_c4_source [xlabel="1"];
    OV_c3_title -> OV_c_label [xlabel="1"];
    OV_c4_arch_url -> OV_c_label [xlabel="2"];
    OV_c4_mono -> OV_c3_desc [xlabel="1"];
    OV_c4_mono -> OV_c3_ident [xlabel="3"];
    OV_c4_mono -> OV_c4_pub_date [xlabel="2"];
    OV_c4_mono -> OV_c4_series_ev [xlabel="2"];
    OV_c4_mono -> OV_c_label [xlabel="4"];
    OV_c4_pub_date -> OV_c2_date [xlabel="11"];
    OV_c4_pub_date -> OV_c_label [xlabel="1"];
    OV_c4_serial -> OV_c3_title [xlabel="1"];
    OV_c4_serial -> OV_c4_mono [xlabel="2"];
    OV_c4_serial -> OV_c4_pub_date [xlabel="3"];
    OV_c4_serial -> OV_c_label [xlabel="5"];
    OV_c4_series_ev -> OV_c2_date [xlabel="2"];
    OV_c4_series_ev -> OV_c_label [xlabel="4"];
    OV_c4_source -> OV_c4_mono [xlabel="1"];
    OV_c4_source -> OV_c4_serial [xlabel="1"];
    OV_c5_notes -> OV_c1_author [xlabel="1"];
    OV_c5_notes -> OV_c3_title [xlabel="1"];
    OV_c5_notes -> OV_c4_arch_url [xlabel="1"];
}