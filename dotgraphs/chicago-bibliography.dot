        label_chapter_number_capitalized [label="label-chapter-number-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_collection_number [label="label-collection-number", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_edition [label="label-edition", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_edition_capitalized [label="label-edition-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_issue [label="label-issue", shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
        label_locator [label="label-locator", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_locator_all [label="label-locator-all", shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
        label_number_capitalized [label="label-number-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_number_of_volumes [label="label-number-of-volumes", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_page [label="label-page", shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
        label_part_number [label="label-part-number", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_part_number_capitalized [label="label-part-number-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_section_capitalized [label="label-section-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_section_symbol [label="label-section-symbol", shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
        label_supplement_number [label="label-supplement-number", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_version [label="label-version", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_version_capitalized [label="label-version-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_volume [label="label-volume", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        label_volume_capitalized [label="label-volume-capitalized", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c4_serial {
        label="§4.1 Serial"; style=filled; fillcolor="#EBF5EB";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        source_serial_bib [label="source-serial-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        source_serial_identifier_bib [label="source-serial-identifier-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
