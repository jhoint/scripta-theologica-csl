digraph CSL_Macros {
    label="CSL Bibliography";
    labelloc=t;
    rankdir=LR;
    concentrate=true;
    splines=curved;
    fontname="Helvetica"; fontsize=13;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.6];

    subgraph cluster_legend {
        label="Leyenda"; style=dotted; fontsize=9; rank=sink;
        _L_entry [label="<citation>\n<bibliography>", shape=ellipse, style=filled, fillcolor="#AED6F1", fontsize=8];
        _L_cond  [label="Condicional\n(con <choose>)", shape=hexagon, style=filled, fillcolor="#FFF2CC", fontsize=8];
        _L_term  [label="Terminal\n(solo variables)", shape=box, style="filled,rounded", fillcolor="#FCE5CD", fontsize=8];
        _L_aggr  [label="Agregadora\n(llama macros)", shape=box, style=filled, fillcolor="#FFFFFF", fontsize=8];
        _L_norm  [label="llamada normal", shape=plaintext, fontsize=8];
        _L_sub   [label="llamada substitute", shape=plaintext, fontsize=8];
        _L_norm -> _L_sub [style=dashed, color=gray, arrowsize=0.5];
    }

    __bibliography__ [label="<bibliography>", shape=ellipse, style=filled, fillcolor="#A9DFBF"];
    { rank=same; __bibliography__ }

    subgraph cluster_c1_author {
        label="§1 Autor"; style=filled; fillcolor="#D6EAF8";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        author_bib [label="author-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        author_sort [label="author-sort", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        author_title_substitute_bib [label="author-title-substitute-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        author_title_substitute_container [label="author-title-substitute-container", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c2_date {
        label="§2 Fecha"; style=filled; fillcolor="#D1F8F5";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        date_event_full [label="date-event-full", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_event_year [label="date-event-year", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_issued_full [label="date-issued-full", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_issued_year [label="date-issued-year", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_issued_year_month [label="date-issued-year-month", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_original_full [label="date-original-full", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_original_year [label="date-original-year", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        date_original_year_month [label="date-original-year-month", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c3_title {
        label="§3.1 Título"; style=filled; fillcolor="#FEF9E7";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        title_and_descriptions_bib [label="title-and-descriptions-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_and_part_filter_review_bib [label="title-and-part-filter-review-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_and_part_title_bib [label="title-and-part-title-bib", shape=box, style=filled, fillcolor="#FFFFFF"];
        title_and_source_bib [label="title-and-source-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_bib [label="title-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_part [label="title-part", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_primary [label="title-primary", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        title_volume [label="title-volume", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c3_desc {
        label="§3.2 Descripción"; style=filled; fillcolor="#FEF3E2";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        description_bib [label="description-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_format_bib [label="description-format-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_format_note [label="description-format-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_interview_bib [label="description-interview-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_letter_bib [label="description-letter-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_paper_conference_bib [label="description-paper-conference-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_bib [label="description-review-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_genre_bib [label="description-review-genre-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_term_unsigned_bib [label="description-review-term-unsigned-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_review_title [label="description-review-title", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        description_serial_bib [label="description-serial-bib", shape=box, style=filled, fillcolor="#FFFFFF"];
        description_song_bib [label="description-song-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c3_ident {
        label="§3.3 Identificadores"; style=filled; fillcolor="#FDEBD0";
        fontname="Helvetica"; fontsize=11; fontcolor="#444444";
        identifier_bib [label="identifier-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_and_volume_bib [label="identifier-contributors-and-volume-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_and_volume_monographic_bib [label="identifier-contributors-and-volume-monographic-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_bib [label="identifier-contributors-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_monographic_bib [label="identifier-contributors-monographic-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_monographic_bib_multivolume [label="identifier-contributors-monographic-bib-multivolume", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_contributors_serial_bib [label="identifier-contributors-serial-bib", shape=box, style="filled,rounded", fillcolor="#FCE5CD"];
        identifier_edition_bib [label="identifier-edition-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_edition_note [label="identifier-edition-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_number_bib [label="identifier-number-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_patent [label="identifier-patent", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_report_bib [label="identifier-report-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_volume_bib [label="identifier-volume-bib", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
        identifier_volume_note [label="identifier-volume-note", shape=hexagon, style=filled, fillcolor="#FFF2CC"];
    }

    subgraph cluster_c_label {
        label="Etiquetas"; style=filled; fillcolor="#F2F3F4";
