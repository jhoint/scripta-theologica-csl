<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="sort-only" default-locale="es-ES">
  <info>
    <title>Scripta Theologica CMOS</title>
    <title-short>ScrTh CMOS</title-short>
    <id>https://github.com/jhoint/scripta-theologica-csl/blob/master/scripta-theologica-cmos.csl</id>
    <link href="https://github.com/jhoint/scripta-theologica-csl/blob/master/scripta-theologica-cmos.csl" rel="self"/>
    <link href="https://revistas.unav.edu/index.php/scripta-theologica/about/submissions" rel="documentation"/>
    <author>
      <name>Juan Tejero</name>
      <email>juantejero@alumni.unav.es</email>
      <uri>https://orcid.org/0000-0002-5363-9233</uri>
    </author>
    <category citation-format="note"/>
    <category field="theology"/>
    <issn>0036-9764</issn>
    <eissn>2254-6227</eissn>
    <summary>Estilo para la revista Scripta Theologica de la Universidad de Navarra. Formato de citación en pruebas. En esta versión voy a intentar seguir el modo en que está construido el estilo de Chicago.</summary>
    <updated>2026-02-20T12:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>


  <locale xml:lang="es">
    <terms>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
      <term name="editor" form="verb-short">ed.</term>
      <term name="director" form="short">
        <single>dir.</single>
        <multiple>dirs.</multiple>
      </term>
      <term name="editorial-director" form="short">
        <single>dir.</single>
        <multiple>dirs.</multiple>
      </term>
      <term name="translator" form="short">trad.</term>
      <term name="editortranslator" form="short">ed. y trad.</term>
      <term name="edition" form="short">ed.</term>
      <term name="volume" form="short">vol.</term>
      <term name="and">y</term>
      <term name="et-al">y otros</term>
      <term name="accessed">recuperado de</term>
      <term name="cited">citado</term>
      <term name="no date">sin fecha</term>
    </terms>
  </locale>

  <!-- MACROS -->

  <!-- ============================================ -->
  <!-- 1. AUTHOR MACROS -->
  <!-- ============================================ -->

  <macro name="author-note">
    <names variable="author">
      <name name-as-sort-order="all" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" font-variant="small-caps"/>
        <name-part name="given"/>
      </name>
      <et-al font-variant="normal"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title-note"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", ">
        <name-part name="family" font-variant="small-caps"/>
      </name>
      <et-al font-variant="normal"/>
      <substitute>
        <names variable="editor" form="short"/>
        <names variable="translator" form="short"/>
        <text macro="title-short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bib">
    <names variable="author">
      <name name-as-sort-order="all" and="text" sort-separator=", " delimiter=", " delimiter-precedes-last="never">
        <name-part name="family" font-variant="small-caps"/>
        <name-part name="given"/>
      </name>
      <et-al font-variant="normal"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title-bib"/>
      </substitute>
    </names>
  </macro>

  <!-- ============================================ -->
  <!-- 2. DATE MACROS -->
  <!-- ============================================ -->

  <macro name="date-issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="date-issued-full">
    <date variable="issued" form="text"/>
  </macro>

  <!-- ============================================ -->
  <!-- 3. TITLE MACROS -->
  <!-- ============================================ -->

  <macro name="title-note">
    <choose>
      <if type="classic">
        <text variable="title" font-style="italic"/>
      </if>
      <else-if type="book thesis" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia article-journal article-magazine article-newspaper" match="any">
        <text variable="title" prefix="«" suffix="»"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="title-short">
    <choose>
      <if type="classic">
        <text variable="title" font-style="italic" form="short"/>
      </if>
      <else-if type="book thesis" match="any">
        <text variable="title" font-style="italic" form="short"/>
      </else-if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia article-journal article-magazine article-newspaper" match="any">
        <text variable="title" form="short" prefix="«" suffix="»"/>
      </else-if>
      <else>
        <text variable="title" form="short" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="title-bib">
    <choose>
      <if type="classic">
        <text variable="title" font-style="italic"/>
      </if>
      <else-if type="book thesis" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="chapter paper-conference entry-dictionary entry-encyclopedia article-journal article-magazine article-newspaper" match="any">
        <text variable="title" prefix="«" suffix="»"/>
      </else-if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- ============================================ -->
  <!-- 4. SOURCE MACROS -->
  <!-- ============================================ -->

  <macro name="container-title">
    <choose>
      <if type="article-journal article-magazine article-newspaper entry-dictionary entry-encyclopedia" match="any">
        <choose>
          <if variable="container-title-short">
            <text variable="container-title-short" font-style="italic"/>
          </if>
          <else>
            <text variable="container-title" font-style="italic"/>
          </else>
        </choose>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <text variable="container-title" font-style="italic"/>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="book chapter paper-conference thesis entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=": ">
          <text variable="publisher-place"/>
          <text variable="publisher"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="collection-title">
    <text variable="collection-title" font-style="italic"/>
  </macro>

  <macro name="container-author">
    <names variable="container-author">
      <name name-as-sort-order="all" and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="." font-variant="small-caps"/>
      <et-al font-variant="normal"/>
    </names>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <group>
            <number variable="edition" form="numeric"/>
            <text value="."/>
            <text value="a" vertical-align="sup"/>
          </group>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="volume">
    <choose>
      <if type="book" match="any">
        <choose>
          <if is-numeric="volume">
            <group delimiter=" ">
              <number variable="volume" form="roman" text-case="uppercase"/>
            </group>
          </if>
          <else>
            <text variable="volume"/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="pages">
    <text variable="page"/>
  </macro>

  <macro name="classic-series-volume">
    <group delimiter=" ">
      <choose>
        <if variable="collection-title-short">
          <text variable="collection-title-short"/>
        </if>
        <else>
          <text variable="collection-title"/>
        </else>
      </choose>
      <text variable="volume"/>
    </group>
  </macro>

  <macro name="classic-editor">
    <group delimiter=" ">
      <text value="en"/>
      <names variable="editor">
        <name name-as-sort-order="all" and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="." font-variant="normal"/>
      </names>
      <text value="(ed.)"/>
    </group>
  </macro>

  <macro name="source-note">
    <choose>
      <if type="book">
        <group delimiter=", ">
          <text macro="volume"/>
          <text macro="edition"/>
          <text macro="publisher"/>
          <text macro="date-issued"/>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="container-author">
              <group>
                <text value="en "/>
                <text macro="container-author"/>
              </group>
            </if>
            <else-if variable="editor editorial-director director" match="any">
              <group>
                <text value="en "/>
                <names variable="editor editorial-director director">
                  <name name-as-sort-order="all" and="text" delimiter=", " delimiter-precedes-last="never">
                    <name-part name="family" font-variant="small-caps"/>
                    <name-part name="given"/>
                  </name>
                  <et-al font-variant="normal"/>
                  <label form="short" prefix=" (" suffix=")"/>
                </names>
              </group>
            </else-if>
          </choose>
          <text macro="container-title"/>
          <text macro="publisher"/>
          <text macro="date-issued"/>
        </group>
      </else-if>
      <else-if type="article-journal">
        <group delimiter=" ">
          <text macro="container-title"/>
          <group>
            <text variable="volume"/>
            <text variable="issue" prefix="/"/>
          </group>
          <text macro="date-issued" prefix="(" suffix=")"/>
        </group>
      </else-if>
      <else-if type="entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text value="en"/>
          <text macro="container-title"/>
          <text variable="volume"/>
          <text macro="date-issued" prefix="(" suffix=")"/>
          <choose>
            <if variable="locator">
              <text variable="locator"/>
            </if>
            <else>
              <text macro="pages"/>
            </else>
          </choose>
        </group>
      </else-if>
      <else-if type="classic">
        <group delimiter=": ">
          <text variable="locator"/>
          <text macro="classic-series-volume"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="date-issued"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="source-bib">
    <choose>
      <if type="book">
        <group delimiter=", ">
          <text macro="volume"/>
          <text macro="edition"/>
          <text macro="publisher"/>
          <text macro="date-issued"/>
        </group>
      </if>
      <else-if type="chapter paper-conference" match="any">
        <group delimiter=", ">
          <choose>
            <if variable="container-author">
              <group>
                <text value="en "/>
                <text macro="container-author"/>
              </group>
            </if>
            <else-if variable="editor editorial-director director" match="any">
              <group>
                <text value="en "/>
                <names variable="editor editorial-director director">
                  <name name-as-sort-order="all" and="text" delimiter=", " delimiter-precedes-last="never">
                    <name-part name="family" font-variant="small-caps"/>
                    <name-part name="given"/>
                  </name>
                  <et-al font-variant="normal"/>
                  <label form="short" prefix=" (" suffix=")"/>
                </names>
              </group>
            </else-if>
          </choose>
          <text macro="container-title"/>
          <text macro="publisher"/>
          <text macro="date-issued"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="article-journal">
        <group>
          <group delimiter=" ">
            <text macro="container-title"/>
            <group>
              <text variable="volume"/>
              <text variable="issue" prefix="/"/>
            </group>
            <text macro="date-issued" prefix="(" suffix=")"/>
          </group>
          <text macro="pages" prefix=", "/>
        </group>
      </else-if>
      <else-if type="entry-dictionary entry-encyclopedia" match="any">
        <group delimiter=" ">
          <text value="en"/>
          <text macro="container-title"/>
          <text variable="volume"/>
          <text macro="date-issued" prefix="(" suffix=")"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else-if type="classic">
        <group delimiter=", ">
          <group delimiter=": ">
            <text variable="locator"/>
            <group delimiter=", ">
              <text macro="classic-editor"/>
              <text macro="classic-series-volume"/>
            </group>
          </group>
          <text variable="publisher-place"/>
          <text macro="date-issued"/>
          <text macro="pages"/>
        </group>
      </else-if>
      <else>
        <group delimiter=", ">
          <text macro="publisher"/>
          <text macro="date-issued"/>
          <text macro="pages"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ============================================ -->
  <!-- 5. LAYOUT MACROS -->
  <!-- ============================================ -->

  <macro name="citation-locator-pages-full">
    <choose>
      <if type="entry-dictionary entry-encyclopedia classic" match="none">
        <choose>
          <if variable="locator">
            <text variable="locator" prefix=", "/>
          </if>
          <else>
            <text macro="pages" prefix=", "/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="citation-locator-pages-short">
    <choose>
      <if type="entry-dictionary entry-encyclopedia" match="none">
        <choose>
          <if variable="locator">
            <text variable="locator" prefix=", "/>
          </if>
          <else>
            <text macro="pages" prefix=", "/>
          </else>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="access-url">
    <choose>
      <if variable="DOI"/>
      <else-if variable="URL">
        <group delimiter=" ">
          <text term="accessed"/>
          <text variable="URL"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="access-doi">
    <choose>
      <if variable="DOI">
        <group>
          <text value=". "/>
          <text variable="DOI" prefix="https://doi.org/"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="citation-notes-shortened-author-title">
    <group>
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="title-short"/>
      </group>
      <text macro="citation-locator-pages-short"/>
      <text macro="access-doi"/>
    </group>
  </macro>

  <macro name="citation-notes-full">
    <group>
      <group delimiter=", ">
        <text macro="author-note"/>
        <text macro="title-note"/>
        <text macro="source-note"/>
      </group>
      <text macro="citation-locator-pages-full"/>
      <text macro="access-url" prefix=", "/>
      <text macro="access-doi"/>
    </group>
  </macro>

  <macro name="bibliography-layout">
    <group>
      <group delimiter=", ">
        <text macro="author-bib"/>
        <text macro="title-bib"/>
        <text macro="source-bib"/>
      </group>
      <text macro="access-url" prefix=", "/>
      <text macro="access-doi"/>
    </group>
  </macro>


  <!-- CITATION -->
  <citation disambiguate-add-names="true" et-al-min="4" et-al-use-first="1">
    <layout delimiter="; " suffix=".">
      <choose>
        <if position="subsequent">
          <text macro="citation-notes-shortened-author-title"/>
        </if>
        <else>
          <text macro="citation-notes-full"/>
        </else>
      </choose>
    </layout>
  </citation>


  <!-- BIBLIOGRAPHY -->
  <bibliography et-al-min="4" et-al-use-first="1" hanging-indent="true">
    <sort>
      <key macro="author-bib"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="bibliography-layout"/>
    </layout>
  </bibliography>

</style>
